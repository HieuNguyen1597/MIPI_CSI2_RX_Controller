# <configuration> <test> <seed>
# Every test runs on all four configurations. Random tests run seeds 1-3 on each configuration.
# test_checker_fault is not listed: it must end in FAIL and is run once by hand to confirm that
# the checker reports errors.
default       test_interface               1
default       test_async_resetn            1
default       test_soft_reset              1
default       test_lb_flush                1
default       test_write_qualification     1
default       test_latency_throughput      1
default       test_random_backpressure     1
default       test_random_backpressure     2
default       test_random_backpressure     3
default       test_field_passthrough       1
default       test_field_passthrough       2
default       test_field_passthrough       3
default       test_occupancy_thresholds    1
default       test_overflow_eol_slot       1
default       test_sim_write_consume       1
default       test_pointer_wrap            1
default       test_pointer_wrap            2
default       test_pointer_wrap            3
default       test_tpg_source              1
default       test_unpoliced_inputs  1
default       test_random_stress_clears    1
default       test_random_stress_clears    2
default       test_random_stress_clears    3
default       test_no_stale_entries        1
default       test_output_stage_corners    1
