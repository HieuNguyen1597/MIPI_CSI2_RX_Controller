# <configuration> <parameters>; the first line is the default.
# TB_CLK_SET is a testbench parameter: lite_aclk / sys_clk / rxbyteclkhs periods
# 0 = 10 / 6.4 / 8 ns, 1 = 10 / 13 / 21 ns, 2 = 10 / 10.3 / 8 ns.
default_clk0  PARA_MAX_LANES=4 PARA_N_EXTRACT=2 PARA_MAX_OUTSTANDING=8 PARA_SYNC_STAGES=2 PARA_PHY_RST_CYCLES=40 PARA_IRQ_CLR_TIMEOUT=16 TB_CLK_SET=0
default_clk1  PARA_MAX_LANES=4 PARA_N_EXTRACT=2 PARA_MAX_OUTSTANDING=8 PARA_SYNC_STAGES=2 PARA_PHY_RST_CYCLES=40 PARA_IRQ_CLR_TIMEOUT=16 TB_CLK_SET=1
default_clk2  PARA_MAX_LANES=4 PARA_N_EXTRACT=2 PARA_MAX_OUTSTANDING=8 PARA_SYNC_STAGES=2 PARA_PHY_RST_CYCLES=40 PARA_IRQ_CLR_TIMEOUT=16 TB_CLK_SET=2
min_clk1      PARA_MAX_LANES=1 PARA_N_EXTRACT=0 PARA_MAX_OUTSTANDING=1 PARA_SYNC_STAGES=2 PARA_PHY_RST_CYCLES=1 PARA_IRQ_CLR_TIMEOUT=1 TB_CLK_SET=1
mid_clk1      PARA_MAX_LANES=2 PARA_N_EXTRACT=1 PARA_MAX_OUTSTANDING=127 PARA_SYNC_STAGES=3 PARA_PHY_RST_CYCLES=5 PARA_IRQ_CLR_TIMEOUT=3 TB_CLK_SET=1
cntmax_clk1   PARA_MAX_LANES=4 PARA_N_EXTRACT=2 PARA_MAX_OUTSTANDING=8 PARA_SYNC_STAGES=2 PARA_PHY_RST_CYCLES=65535 PARA_IRQ_CLR_TIMEOUT=65535 TB_CLK_SET=1
