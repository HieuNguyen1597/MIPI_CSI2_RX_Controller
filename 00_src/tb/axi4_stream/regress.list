# <configuration> <test> <seed>
# The seed also selects the clocks: 1, 4 -> axis_aclk 1.818 ns, sys_clk 4.464 ns; 2, 5 -> both
# 4.464 ns; 3, 6 -> axis_aclk 10 ns, sys_clk 4.464 ns. test_checker_fault is not listed: it must
# end in FAIL and is run once by hand to confirm that the checks report errors.
# Every configuration runs every test at the three clock ratios; on default the tests with
# random choices run three more seeds.
default          test_reset_both_domains    1
default          test_reset_both_domains    2
default          test_reset_both_domains    3
default          test_line_lengths          1
default          test_line_lengths          2
default          test_line_lengths          3
default          test_random_streaming      1
default          test_random_streaming      2
default          test_random_streaming      3
default          test_fifo_full_stall       1
default          test_fifo_full_stall       2
default          test_fifo_full_stall       3
default          test_throughput            1
default          test_throughput            2
default          test_throughput            3
default          test_latency               1
default          test_latency               2
default          test_latency               3
default          test_abort_cases           1
default          test_abort_cases           2
default          test_abort_cases           3
default          test_abort_stalled         1
default          test_abort_stalled         2
default          test_abort_stalled         3
default          test_abort_reassert        1
default          test_abort_reassert        2
default          test_abort_reassert        3
default          test_abort_nothing_open    1
default          test_abort_nothing_open    2
default          test_abort_nothing_open    3
default          test_frame_gate            1
default          test_frame_gate            2
default          test_frame_gate            3
default          test_skip                  1
default          test_skip                  2
default          test_skip                  3
default          test_axis_enable           1
