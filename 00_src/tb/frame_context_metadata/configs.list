# <configuration> <parameters>; the first line is the default.
# PARA_TS_INCR: 67108864 = 0x0400_0000 (250 MHz), 74898286 = 0x0476_DB6E (224 MHz),
# 2147483647 = 0x7FFF_FFFF (largest value an unsized decimal literal can carry on the
# -defparam command line).
ext2_depth16_ts250  PARA_N_EXTRACT=2 PARA_META_FIFO_DEPTH=16 PARA_TS_INCR=67108864
ext0_depth16_ts250  PARA_N_EXTRACT=0 PARA_META_FIFO_DEPTH=16 PARA_TS_INCR=67108864
ext1_depth2_ts224   PARA_N_EXTRACT=1 PARA_META_FIFO_DEPTH=2 PARA_TS_INCR=74898286
ext2_depth2_ts250   PARA_N_EXTRACT=2 PARA_META_FIFO_DEPTH=2 PARA_TS_INCR=67108864
ext0_depth64_ts224  PARA_N_EXTRACT=0 PARA_META_FIFO_DEPTH=64 PARA_TS_INCR=74898286
ext1_depth16_tsbig  PARA_N_EXTRACT=1 PARA_META_FIFO_DEPTH=16 PARA_TS_INCR=2147483647
