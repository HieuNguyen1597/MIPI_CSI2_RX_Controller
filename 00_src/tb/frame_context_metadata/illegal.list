# Illegal parameter values; elaboration must stop with an error for each.
# PARA_META_FIFO_DEPTH 0 and 1 are also rejected at elaboration, but they may stop before the
# parameter check (the pointer width becomes 0), so they are not listed here.
n_extract_3  PARA_N_EXTRACT=3
depth_3      PARA_META_FIFO_DEPTH=3
depth_12     PARA_META_FIFO_DEPTH=12
ts_incr_0    PARA_TS_INCR=0
