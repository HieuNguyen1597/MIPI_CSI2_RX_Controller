# <configuration> <test> <seed>
# The seed also selects the clock ratio: 1, 4 -> sys_clk 5 ns, mm_aclk 13 ns; 2, 5 -> 5 ns,
# 5.3 ns; 3, 6 -> 10 ns, 6 ns. test_checker_fault is not listed: it must end in FAIL and is
# run once by hand to confirm that the checks report errors.
# default: every test at the three clock ratios; tests with random choices at six seeds.
default  test_reset_idle  1
default  test_reset_idle  2
default  test_reset_idle  3
default  test_single_capture  1
default  test_single_capture  2
default  test_single_capture  3
default  test_hdr_capture  1
default  test_hdr_capture  2
default  test_hdr_capture  3
default  test_hdr_capture  4
default  test_hdr_capture  5
default  test_hdr_capture  6
default  test_burst_split  1
default  test_burst_split  2
default  test_burst_split  3
default  test_line_pitch_clip  1
default  test_line_pitch_clip  2
default  test_line_pitch_clip  3
default  test_metadata_layout  1
default  test_metadata_layout  2
default  test_metadata_layout  3
default  test_record_burst  1
default  test_record_burst  2
default  test_record_burst  3
default  test_meta_backpressure  1
default  test_meta_backpressure  2
default  test_meta_backpressure  3
default  test_claim_gating  1
default  test_claim_gating  2
default  test_claim_gating  3
default  test_buffer_release  1
default  test_buffer_release  2
default  test_buffer_release  3
default  test_abort_req  1
